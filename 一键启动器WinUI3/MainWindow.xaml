<Window
    x:Class="QuickLauncherWinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="启伴·一键启动器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Image x:Name="BackgroundPicture" Grid.RowSpan="3" Stretch="Uniform" IsHitTestVisible="False"/>
        <Border x:Name="BackgroundShade" Grid.RowSpan="3" IsHitTestVisible="False"/>


        <!-- 顶栏 -->
        <Grid Grid.Row="0" Height="56" Padding="16,0" ColumnSpacing="10"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="启伴·一键启动器" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="勾选即启 · 一键全开" FontSize="11"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox Grid.Column="2" x:Name="SearchBox" PlaceholderText="搜索软件（可按名称、后缀、路径搜索）" MinWidth="120"
                     HorizontalAlignment="Stretch" Margin="12,0" VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="4" x:Name="AddAppBtn" Content="＋ 添加软件"
                    Style="{StaticResource AccentButtonStyle}" Click="AddApp_Click" VerticalAlignment="Center"/>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：分组 -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="8,10,8,6" Spacing="10">
                    <ToggleButton x:Name="MainCatalogButton" Content="主目录" Click="MainCatalog_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="全部软件：搜索、排序、筛选后归入分组"/>
                    <TextBlock Text="分组" Margin="8,2,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ListView Grid.Row="1" x:Name="CatList" SelectionChanged="CatList_SelectionChanged"
                          Padding="8,0" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" CornerRadius="10"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- 左栏底部按钮 -->
                <StackPanel Grid.Row="2" Padding="8,8" Spacing="6">
                    <Button Content="＋ 新建分组" Style="{StaticResource AccentButtonStyle}"
                            Click="AddCat_Click" HorizontalAlignment="Stretch"/>
                    <Button Content="扫描并添加软件" Click="Scan_Click" HorizontalAlignment="Stretch"/>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="改名" Click="RenameCat_Click"/>
                        <Button Grid.Column="1" Content="删除" Click="DeleteCat_Click"/>
                    </Grid>
                    <Button x:Name="SettingsButton" Click="Settings_Click" HorizontalAlignment="Stretch" ToolTipService.ToolTip="主题、背景、主目录扫描、排除名单、备份和版本更新"/>
                </StackPanel>
            </Grid>

            <!-- 主区：软件 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="16,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10"><ComboBox x:Name="CatalogFilter" SelectedIndex="0" SelectionChanged="CatalogFilter_SelectionChanged" MinWidth="100"><ComboBoxItem Content="全部"/><ComboBoxItem Content="未分组"/><ComboBoxItem Content="已分组"/></ComboBox><ComboBox x:Name="AppSort" SelectedIndex="0" SelectionChanged="AppSort_SelectionChanged" MinWidth="130"><ComboBoxItem Content="默认顺序"/><ComboBoxItem Content="名称排序"/><ComboBoxItem Content="后缀排序"/><ComboBoxItem Content="路径排序"/></ComboBox><TextBlock x:Name="AppCountText" Text="软件 (0)" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/></StackPanel>
                    <Button Grid.Column="1" Content="全选" Click="SelectAll_Click"/>
                    <Button Grid.Column="2" Content="全不选" Click="SelectNone_Click"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                        <DropDownButton Content="整理勾选">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="归入 / 复制到分组…" Click="CopyChecked_Click"/>
                                    <MenuFlyoutItem Text="移动勾选到分组…" Click="MoveChecked_Click"/>
                                    <MenuFlyoutSeparator/>
                                    <MenuFlyoutItem Text="删除勾选记录…" Click="DeleteChecked_Click"/>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <Button Content="删除勾选…" Click="DeleteChecked_Click"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" x:Name="AppSelectionSurface" Background="Transparent">
                <ListView x:Name="AppList" SelectionMode="Single" Padding="8,0"
                          RightTapped="AppList_RightTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4" ColumnSpacing="12" CornerRadius="8"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsHitTestVisible="False" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <Image Grid.Column="1" Source="{Binding Icon}" Width="30" Height="30"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="{Binding FullPath}" FontSize="11" TextWrapping="Wrap"
                                               IsTextSelectionEnabled="False"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="以管理员运行" FontSize="11"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               Visibility="{Binding AdminBadge}"/>
                                    <TextBlock Text="{Binding Membership}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding MembershipVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Canvas x:Name="AppSelectionOverlay" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 底栏 -->
        <Grid Grid.Row="2" Height="60" Padding="16,0" ColumnSpacing="12"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Text="勾选要打开的软件 → 点右下角「启动勾选」；双击单项单独启动；可把文件拖进窗口"
                       FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
            <ToggleSwitch x:Name="AdminToggle" Header="以管理员权限启动" IsOn="False" MinWidth="140" VerticalAlignment="Center"/>
            <ToggleSwitch x:Name="UncheckToggle" Header="启动后取消勾选" IsOn="False"
                          MinWidth="140" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="LaunchBtn" Grid.Column="2" Content="启动勾选 (0)" MinWidth="180" Height="42"
                    Style="{StaticResource AccentButtonStyle}" Click="Launch_Click"
                    VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</Window>
